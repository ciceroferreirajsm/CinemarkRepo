{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://mongodb:27017",
    "DatabaseName": "moviecatalog",
    "FilmsCollectionName": "films",
    "MaxConnectionPoolSize": 100,
    "MinConnectionPoolSize": 5,
    "ConnectTimeoutSeconds": 10,
    "ServerSelectionTimeoutSeconds": 10
  },
  "Redis": {
    "ConnectionString": "redis:6379"
  },
  "Cache": {
    "FilmDetailTtlMinutes": 5,
    "FilmListTtlMinutes": 5
  },
  "Sqs": {
    "ServiceUrl": "http://localstack:4566",
    "Region": "us-east-1",
    "AccessKey": "test",
    "SecretKey": "test",
    "FilmCreatedQueueUrl": "http://localstack:4566/000000000000/film-created",
    "FilmUpdatedQueueUrl": "http://localstack:4566/000000000000/film-updated",
    "FilmDeletedQueueUrl": "http://localstack:4566/000000000000/film-deleted"
  }
}
